{
  "name": "chgst/chgst-bundle",
  "description": "Symfony bundle for chgst",
  "type": "library",
  "require": {
    "php": "^8.0",
    "symfony/config": "^7.0",
    "symfony/security-bundle": "^7.0",
    "chgst/chgst": "^0.3.3"
  },
  "require-dev": {
    "phpspec/phpspec": "^8.0.0",
    "pdepend/pdepend": "^2.15",
    "phploc/phploc": "^7.0.2",
    "phpmd/phpmd": "^2.14.1",
    "sebastian/phpcpd": "^6.0.3",
    "friends-of-phpspec/phpspec-code-coverage": "^v7.0.0",
    "php-coveralls/php-coveralls": "^v2.6.0",
    "symfony/expression-language": "^7.0"
  },
  "license": "MIT",
  "minimum-stability": "stable",
  "autoload": {
    "psr-4": {
      "Chgst\\ChgstBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "spec\\Chgst\\ChgstBundle\\": "spec/"
    }
  },
  "config": {}
}
